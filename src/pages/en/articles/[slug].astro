---
import articles from '../../../../data/articles.json';
export function getStaticPaths() {
  return articles.filter(a => a.status === 'published' && a.slug && a.en?.title && Array.isArray(a.en?.body)).map(a => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const paragraphs = article.en.body;
const canonicalUrl = `https://tech-current.net/en/articles/${article.slug}/`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-75LX4FKQDL"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-75LX4FKQDL');
  </script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={article.en.description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="ja" href={`https://tech-current.net/articles/${article.slug}/`} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={`https://tech-current.net/articles/${article.slug}/`} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="TECH CURRENT" />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary" />
{article.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
{article.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
<meta property="og:title" content={article.en.title} />
<meta property="og:description" content={article.en.description} />
<title>{article.en.title} | TECH CURRENT</title>
</head>
<body>
<header><a href="/" class="logo">TECH<span>CURRENT</span></a><div><a href={`/articles/${article.slug}/`} lang="ja">日本語</a>　<a href="/en/">← Back to home</a></div></header>
<main><article>
<div class="category">{article.en.category}</div>
<h1>{article.en.title}</h1>
<p class="summary">{article.en.description}</p>
<div class="meta">Article ID: {article.articleId}　Published: <time datetime={article.publishedAt}>{article.publishedAt?.slice(0,10)}</time>{article.updatedAt && <span>　Updated: {article.updatedAt.slice(0,10)}</span>}</div>
<div class="body">{paragraphs.map((p, index) => <><p>{p}</p>{(article.media ?? []).filter(item => item.afterParagraph === index).map(item => <figure class="article-figure"><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.captionEn ?? item.caption} <span>— {item.creditEn ?? item.credit} · <a href={item.sourceUrl ?? article.sourceUrl} target="_blank" rel="noopener noreferrer">Source</a></span></figcaption></figure>)}</>)}</div>
{article.sourceUrl && <section class="source"><h2>Source</h2><a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">{article.en.sourceName ?? 'Official source'} ↗</a></section>}
</article></main>
<footer>© TECH CURRENT</footer>
</body>
</html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f7fb;color:#12243c;font-family:system-ui,"Noto Sans JP",sans-serif}:global(a){color:#1260d7}header{background:#fff;border-bottom:1px solid #e0e7f1;padding:18px max(24px,calc((100% - 1000px)/2));display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:13px}.logo{font-weight:900;font-size:22px;color:#061a37;text-decoration:none}.logo span{color:#1260e8}main{max-width:880px;margin:35px auto;padding:0 18px}article{background:#fff;padding:clamp(24px,5vw,56px);border:1px solid #e0e7f1;border-radius:10px}.category{display:inline-block;background:#1260e8;color:#fff;border-radius:20px;padding:5px 12px;font-size:12px;font-weight:700}h1{font-size:clamp(26px,4vw,40px);line-height:1.5;margin:20px 0}.summary{font-size:17px;line-height:1.9;color:#455872}.meta{font-size:12px;color:#7b899b;padding:16px 0;border-bottom:1px solid #e7ebf0}.body{font-size:16px;line-height:2.1;padding-top:25px}.body p{margin:0 0 24px}.source{border-top:1px solid #e7ebf0;margin-top:40px;padding-top:22px}.source h2{font-size:16px}footer{text-align:center;color:#7b899b;font-size:12px;padding:40px}.article-figure{margin:30px 0 36px}.article-figure img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #e0e7f1}.article-figure figcaption{margin-top:10px;font-size:12px;line-height:1.8;color:#64748b}.article-figure figcaption span{display:block}</style>