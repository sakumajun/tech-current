---
import articles from '../../../data/articles.json';
export function getStaticPaths() {
  return articles.filter(a => a.status === 'published' && a.slug && a.title && Array.isArray(a.body)).map(a => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const paragraphs = article.body;
const canonicalUrl = `https://tech-current.net/articles/${article.slug}/`;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-75LX4FKQDL"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-75LX4FKQDL');
  </script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={article.description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="TECH CURRENT" />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary" />
{article.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
{article.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
<meta property="og:title" content={article.title} />
<meta property="og:description" content={article.description} />
<title>{article.title} | TECH CURRENT</title>
</head>
<body>
<header><a href="/" class="logo">TECH<span>CURRENT</span></a><a href="/">← トップへ戻る</a></header>
<main><article>
<div class="category">{article.category}</div>
<h1>{article.title}</h1>
<p class="summary">{article.description}</p>
<div class="meta">記事ID：{article.articleId}　公開：<time datetime={article.publishedAt}>{article.publishedAt?.slice(0,10)}</time>{article.updatedAt && <span>　更新：{article.updatedAt.slice(0,10)}</span>}</div>
<div class="body">{paragraphs.map(p => <p>{p}</p>)}</div>
{article.sourceUrl && <section class="source"><h2>情報源</h2><a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">{article.sourceName ?? '公式情報・原文'} ↗</a></section>}
</article></main>
<footer>© TECH CURRENT</footer>
</body>
</html>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#f5f7fb;color:#12243c;font-family:system-ui,"Noto Sans JP",sans-serif}:global(a){color:#1260d7}header{background:#fff;border-bottom:1px solid #e0e7f1;padding:18px max(24px,calc((100% - 1000px)/2));display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:13px}.logo{font-weight:900;font-size:22px;color:#061a37;text-decoration:none}.logo span{color:#1260e8}main{max-width:880px;margin:35px auto;padding:0 18px}article{background:#fff;padding:clamp(24px,5vw,56px);border:1px solid #e0e7f1;border-radius:10px}.category{display:inline-block;background:#1260e8;color:#fff;border-radius:20px;padding:5px 12px;font-size:12px;font-weight:700}h1{font-size:clamp(26px,4vw,40px);line-height:1.5;margin:20px 0}.summary{font-size:17px;line-height:1.9;color:#455872}.meta{font-size:12px;color:#7b899b;padding:16px 0;border-bottom:1px solid #e7ebf0}.body{font-size:16px;line-height:2.1;padding-top:25px}.body p{margin:0 0 24px}.source{border-top:1px solid #e7ebf0;margin-top:40px;padding-top:22px}.source h2{font-size:16px}footer{text-align:center;color:#7b899b;font-size:12px;padding:40px}</style>